---
import BaseHead from '../components/BaseHead.astro'
import Timeline from '../components/Timeline.tsx'
import TextFadeIn from '../components/TextFadeIn.tsx'
import HeroHighlight from '../components/Hightlight.tsx'
import RisenShine from '../components/Rise-n-Shine.astro'
import Summary from '../components/summary.astro'
import StickyScrollComponent from '../components/Sticky.tsx'
import Reaction from '../components/Reaction.astro'

import NavBar from '../components/NavBar.astro'
import Marquee from '../components/Marquee.tsx'
import { Tabs } from '../components/Tabs.tsx'
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts'

const tabsData = [
  { title: 'Tab 1', value: 'tab1', content: '<p>Content for Tab 1</p>' },
  { title: 'Tab 2', value: 'tab2', content: '<p>Content for Tab 2</p>' },
  // ... more tabs
]
---

<!doctype html>
<html lang='en'>
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <RisenShine />
    <div class='relative z-10'>
      <div
        class='h-screen flex flex-col items-center justify-center overflow-hidden'
      >
        <h1
          class='md:text-7xl text-3xl lg:text-6xl font-bold text-center text-white'
        >
          Build great Product
        </h1>
        <NavBar />
        <Summary />
      </div>
      <main class='container mx-auto py-16 px-4'>
        <Marquee />
        <div class='sticky top-0 bg-white shadow-md z-10'>
          <h2 class='text-3xl font-bold text-center py-4'>
            Professional Experiences
          </h2>
        </div>
        <StickyScrollComponent />
        <Reaction />

        <h2>Tech Stacks Experiences</h2>
        <ul>
          <li>Elixir</li>
          <li>Phoenix LiveView</li>
          <li>HTML</li>
          <li>CSS</li>
          <li>TailWind</li>
          <li>React</li>
          <li>Next.js</li>
          <li>Git</li>
          <li>Github</li>
          <li>RESTful API</li>
          <li>Agile Methodologies</li>
          <li>Data Pipeline</li>
          <li>C/C++</li>
          <li>TypeScript</li>
          <li>JavaScript</li>
          <li>GCP</li>
          <li>Postgresql</li>
        </ul>
       


      </main>
    </div>
  </body>
</html>

<Tabs tabs={tabsData} client:load />
