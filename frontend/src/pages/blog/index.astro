---
import BaseHead from '../../components/BaseHead.astro'
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts'
import { getCollection } from 'astro:content'
import FormattedDate from '../../components/FormattedDate.astro'
import { ClientRouter } from 'astro:transitions'
import RisenShine from '../../components/Rise-n-Shine.astro'
import NavBar from '../../components/NavBar.astro'

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)
---

<html lang='en'>
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <RisenShine />
    <div class='w-full h-[45vh] flex justify-center items-center'>
      <NavBar />
    </div>
    <div class='flex flex-row items-start justify-center w-2/3 mx-auto'>
      <!-- Controller starts here -->
      <div class='px-10 py-12 bg-white mx-auto rounded-l-xl'>
        <div>
          <p class='text-4xl font-semibold text-center text-gray-800'>
            Control what you see
          </p>
          <hr class='border-gray-200 border w-full mt-4 mb-6' />
          <div class='px-6'>
            <div class='block' id='togleOne'>
              <div class='flex lg:gap-20 md:gap-10 gap-6'>
                <div class='flex justify-start gap-4 mt-4 items-center'>
                  <input
                    type='radio'
                    name='radio'
                    id=''
                    class='accent-gray-800 w-4 h-4 cursor-pointer'
                  />
                  <p class='text-gray-600 font-normal text-base'>Frontend</p>
                </div>

                <div class='flex justify-start gap-4 mt-4 items-center'>
                  <input
                    type='radio'
                    name='radio'
                    id=''
                    class='accent-gray-800 w-4 h-4 cursor-pointer'
                  />
                  <p class='text-gray-600 font-normal text-base'>Backend</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Contents starts here -->
      <blog>
        <ul class='px-8'>
          {
            posts.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`}>
                  <div class='bg-gray-800 shadow rounded-lg mt-3 flex relative z-30'>
                    <div class='w-2.5 h-auto bg-indigo-700 rounded-tl-md rounded-bl-md' />
                    <div class='rounded-lg pt-4 pl-4 pr-4'>
                        {/* <img width={720} height={360} src={post.data.heroImage} /> */}
                        <h4 class='text-2xl font-semibold text-white'>
                          {post.data.title}
                        </h4>
                        <p class='text-gray-200 text-base border-b border-gray-300'>
                          {post.data.description}
                        </p>
                        <div class=''>
                          <div class=''>
                            <div>
                              <h1 class='text-base text-gray-200 font-semibold'>
                                Tag
                              </h1>
                              <p>
                                <FormattedDate date={post.data.pubDate} />
                              </p>
                            </div>
                          </div>
                        </div>
                    </div>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </blog>
    </div>
    <main transition:animate='initial'></main>
  </body>
</html>
